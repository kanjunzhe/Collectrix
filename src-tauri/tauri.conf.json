{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Collectrix",
  "version": "0.1.0",
  "identifier": "com.kandimord.collectrix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Collectrix",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$HOME/**",
          "$DOWNLOAD/**",
          "$VIDEO/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$APPDATA/**",
          "$TEMP/**"
        ]
      },
      "csp": "frame-src https://player.bilibili.com https://www.youtube.com https://www.youtube-nocookie.com; img-src 'self' asset: http://asset.localhost https: data:; media-src 'self' asset: http://asset.localhost blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
